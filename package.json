{
  "name": "route3-skill",
  "version": "2.1.0",
  "description": "Route3: measured session supervision, efficient expert dispatch, and a native Mac control center for agents, OpenClaw, browser and Telegram.",
  "main": "bin/route3-skill.js",
  "bin": {
    "route3-skill": "bin/route3-skill.js"
  },
  "scripts": {
    "postinstall": "node bin/route3-skill.js install --quiet",
    "start": "node control-center/server.js",
    "test": "node --test test/*.test.js control-center/test/*.test.js",
    "test:legacy": "bash skill/scripts/test-factory-smoke.sh",
    "test:context": "bash skill/context/test-context.sh",
    "test:hooks": "bash skill/hooks/test-hooks.sh",
    "mac": "bash control-center/mac/build.sh"
  },
  "files": [
    "bin/",
    "skill/",
    "agents/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "control-center/*.js",
    "control-center/public/",
    "control-center/mac/*.swift",
    "control-center/mac/*.sh",
    "control-center/mac/README.md",
    "control-center/test/",
    "test/"
  ],
  "keywords": [
    "claude-code",
    "cursor",
    "agent-skill",
    "skill",
    "route3",
    "ai-assistant",
    "multi-agent",
    "orchestrator"
  ],
  "author": "vaqif14",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaqif14/route3-skill.git"
  },
  "bugs": {
    "url": "https://github.com/vaqif14/route3-skill/issues"
  },
  "homepage": "https://github.com/vaqif14/route3-skill#readme",
  "engines": {
    "node": ">=18"
  }
}
