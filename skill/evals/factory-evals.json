{
  "version": "1.4.3",
  "description": "Shell assertions for factory/self-improve gates (see scripts/eval-factory.sh)",
  "cases": [
    {
      "id": "buried-yes-to-all",
      "name": "Buried yes to all must not pass preflight",
      "expect": "preflight_fail"
    },
    {
      "id": "factory-requires-run",
      "name": "check-plan-done --factory without --run fails",
      "expect": "fail"
    },
    {
      "id": "high-risk-classify-factory",
      "name": "Auth/payment plan classifies as factory",
      "expect": "FACTORY class=factory"
    },
    {
      "id": "trivial-without-reason",
      "name": "SKIPPED_TRIVIAL without TRIVIAL_REASON fails preflight",
      "expect": "preflight_fail"
    },
    {
      "id": "product-scrap-blocks-architecture",
      "name": "product VERDICT: SCRAP without PRODUCT_OVERRIDE fails check-stage product",
      "expect": "fail"
    },
    {
      "id": "product-override-passes",
      "name": "Same SCRAP artifact + human PRODUCT_OVERRIDE validates product stage",
      "expect": "STAGE OK"
    },
    {
      "id": "ownership-overlap-fails",
      "name": "Overlapping OWNERSHIP globs fail check-ownership",
      "expect": "OWNERSHIP FAIL"
    },
    {
      "id": "verify-fail-needs-bound-lesson",
      "name": "Factory done after VERIFY FAIL requires a bound lesson (no confidence-stop)",
      "expect": "fail"
    }
  ]
}
